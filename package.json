{
  "name": "sayabot",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sayabot/db generate",
    "db:migrate": "pnpm --filter @sayabot/db migrate",
    "db:seed": "pnpm --filter @sayabot/db seed",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^17.2.0",
    "@types/node": "^24.0.0"
  }
}
